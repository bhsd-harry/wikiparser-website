{
	"name": "wikiparser-website",
	"version": "0.0.0",
	"license": "CC BY-SA 4.0",
	"author": "Bhsd",
	"private": true,
	"scripts": {
		"ls": "npm i --package-lock-only && npm ls --package-lock-only --all --omit=dev",
		"lint:ts": "eslint --cache .",
		"lint:css": "stylelint --cache '**/*.css'",
		"lint:md": "markdownlint-cli2 '**/*.md'",
		"lint:wiki": "wikilint -q -c github -r -e wiki --cache wiki/bips/",
		"lint": "npm run lint:ts && npm run lint:css",
		"build:core": "tsc",
		"build:html": "node dist/build.js",
		"build": "npm run build:core && npm run build:html",
		"server": "npm run test:end; http-server .. -c-1 --cors -s &",
		"test:end": "pkill -x http-server"
	},
	"devDependencies": {
		"@bhsd/code-standard": "^2.5.1",
		"@bhsd/nodejs": "^1.0.1",
		"@stylistic/stylelint-plugin": "^5.2.0",
		"@types/node": "^25.9.0",
		"@typescript-eslint/parser": "^8.59.4",
		"esbuild": "^0.28.0",
		"eslint": "^10.4.0",
		"http-server": "^14.1.1",
		"markdownlint-cli2": "^0.22.1",
		"prism-wiki": "^2.1.1",
		"prismjs": "^1.30.0",
		"stylelint": "^17.12.0",
		"stylelint-config-recommended": "^18.0.0",
		"stylelint-plugin-use-baseline": "^1.4.2",
		"typescript": "^6.0.3",
		"wikilint": "^2.41.0",
		"wikiparser-node": "^1.41.0"
	},
	"engines": {
		"node": "^26.0.0"
	}
}
