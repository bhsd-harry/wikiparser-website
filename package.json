{
	"name": "wikiparser-website",
	"version": "0.0.0",
	"license": "CC BY-SA 4.0",
	"author": "Bhsd",
	"private": true,
	"scripts": {
		"ls": "npm i --package-lock-only && npm ls --package-lock-only --all --omit=dev",
		"lint:ts": "eslint --cache .",
		"lint:css": "stylelint '**/*.css'",
		"lint:md": "markdownlint-cli2 '**/*.md'",
		"lint": "npm run lint:ts && npm run lint:css",
		"build:core": "tsc",
		"build:html": "node dist/build.js",
		"build": "npm run build:core && npm run build:html",
		"server": "npm run test:end; http-server .. -c-1 --cors -s &",
		"test:end": "pkill -x http-server"
	},
	"devDependencies": {
		"@bhsd/code-standard": "^2.4.1",
		"@bhsd/nodejs": "^1.0.0",
		"@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@stylistic/stylelint-plugin": "^5.1.0",
		"@types/node": "^24.11.0",
		"@typescript-eslint/eslint-plugin": "^8.59.1",
		"@typescript-eslint/parser": "^8.59.1",
		"esbuild": "^0.28.0",
		"eslint": "^10.3.0",
		"eslint-plugin-jsdoc": "^62.9.0",
		"eslint-plugin-jsonc": "^3.1.2",
		"eslint-plugin-n": "^17.24.0",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-regexp": "^3.1.0",
		"eslint-plugin-unicorn": "^64.0.0",
		"eslint-plugin-yml": "^3.3.2",
		"http-server": "^14.1.1",
		"markdownlint-cli2": "^0.22.1",
		"prism-wiki": "^2.1.0",
		"prismjs": "^1.30.0",
		"stylelint": "^17.10.0",
		"stylelint-config-recommended": "^18.0.0",
		"stylelint-plugin-use-baseline": "^1.4.1",
		"typescript": "^6.0.3",
		"wikiparser-node": "^1.39.1"
	},
	"engines": {
		"node": "^24.14.0"
	}
}
