{
	"name": "wikiparser-website",
	"license": "CC BY-SA 4.0",
	"author": "Bhsd",
	"private": true,
	"scripts": {
		"lint:ts": "oxlint && eslint --cache .",
		"lint:css": "stylelint --cache '**/*.css'",
		"lint:md": "myMarkdownlint",
		"lint:wiki": "wikilint -q -c github -r -e wiki --cache wiki/bips/",
		"lint": "npm run lint:ts && npm run lint:css",
		"migrate": "oxlint-migrate eslint.config.mjs",
		"build:core": "tsc",
		"build:html": "node dist/build.js && node dist/build.js bips github",
		"build": "npm run build:core && npm run build:html",
		"server": "npm run test:end; http-server .. -c-1 --cors -s &",
		"test:end": "pkill -x http-server",
		"test": "echo 'This package has no tests.'"
	},
	"devDependencies": {
		"@bhsd/code-standard": "^5.1.0",
		"@bhsd/nodejs": "^1.2.1",
		"@oxlint/migrate": "^1.89.0",
		"@types/jsdom": "^30.0.0",
		"dompurify": "^3.4.17",
		"esbuild": "^0.28.2",
		"eslint": "^10.14.0",
		"http-server": "^14.1.1",
		"jsdom": "^30.1.3",
		"katex": "^0.19.1",
		"oxlint": "^1.89.0",
		"prism-wiki": "^2.5.0",
		"prismjs": "^1.30.0",
		"stylelint": "^17.16.0",
		"typescript": "^6.0.3",
		"wikilint": "^2.48.1",
		"wikiparser-node": "^1.48.1"
	},
	"engines": {
		"node": "^26.0.0"
	}
}
